{
    "type": "module",
    "name": "ansible",
    "version": "1.0.0",
    "description": "This repository installs packages and applications that I use in my daily work",
    "scripts": {
        "format": "prettier . --write",
        "prepare": "husky"
    },
    "author": "Alexis Zamanidis",
    "license": "MIT",
    "devDependencies": {
        "prettier": "^2.8.0",
        "@alexiszamanidis/prettier-config": "1.0.1",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2"
    },
    "prettier": "@alexiszamanidis/prettier-config",
    "lint-staged": {
        "!(*.yml|*.yaml)": "prettier --write --ignore-unknown",
        "*.{yml,yaml}": "ansible-lint --fix -c ./.ansible-lint"
    }
}
